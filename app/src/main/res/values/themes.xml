<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar: у каждого экрана свой кастомный заголовок/шапка.
         Системный ActionBar убран — иначе его лейбл «Поток» дублировал
         in-app заголовок на главном экране. -->
    <style name="Theme.VoiceNotes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>
</resources>

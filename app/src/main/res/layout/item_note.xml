<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка заметки (развитая — с превью). Белая, скруглённая, с тонкой рамкой.
     Слева — цветная плитка-тип (скруглённый квадрат + белая иконка).
     Заголовок + время справа, ниже — превью. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/space_m"
    android:background="@drawable/bg_card_note"
    android:elevation="1dp"
    android:gravity="top">

    <!-- Плитка-тип: цвет заливки ставится per-type через backgroundTintList
         в адаптере; иконка белая. -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_type_note"
        android:background="@drawable/bg_type_tile"
        android:tint="@color/bg_card"
        android:scaleType="centerInside"
        android:padding="6dp"
        android:contentDescription="Тип заметки" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Potok.Title"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Potok.Body"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_s">

            <TextView
                android:id="@+id/devMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/accent_blue"
                android:visibility="gone" />

            <TextView
                android:id="@+id/calChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:background="@color/cal_bg"
                android:textColor="@color/cal_text"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:paddingLeft="@dimen/space_s"
                android:paddingRight="@dimen/space_s"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="⏰ Напоминание"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

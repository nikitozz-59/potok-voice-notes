<?xml version="1.0" encoding="utf-8"?>
<!-- Строка заметки (развитая — с превью). Плоская: без карточного фона,
     без цветного облачка по типу. Тип кодируется только emoji-иконкой.
     Разделитель — у ListView (divider), не у строки. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/space_l"
    android:paddingRight="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_m"
    android:gravity="top">

    <!-- Иконка-тип: векторная, монохромная, tint text_secondary.
         Тип кодируется формой иконки, не цветом — лаконично. -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_type_note"
        android:tint="@color/text_secondary"
        android:scaleType="centerInside"
        android:contentDescription="Тип заметки" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/space_s">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Potok.Title"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Potok.Body"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_s">

            <TextView
                android:id="@+id/devMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/accent_blue"
                android:visibility="gone" />

            <TextView
                android:id="@+id/calChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:background="@color/cal_bg"
                android:textColor="@color/cal_text"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:paddingLeft="@dimen/space_s"
                android:paddingRight="@dimen/space_s"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="⏰ Напоминание"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Шапка: «Поток» + ⋮ (overflow). Как на референсе. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="12dp"
            android:paddingTop="20dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Potok.Headline"
                android:textColor="@color/text_primary"
                android:text="Поток" />

            <ImageButton
                android:id="@+id/overflowBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_more"
                android:tint="@color/text_primary"
                android:scaleType="centerInside"
                android:contentDescription="Меню" />
        </LinearLayout>

        <!-- Строка статуса синхронизации: постоянная, тонкая.
             Resting — «✓ Синхронизировано» (зелёная галочка + серый текст). -->
        <LinearLayout
            android:id="@+id/syncBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="0dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/syncIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/sync_ok"
                android:text="✓" />

            <TextView
                android:id="@+id/syncText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary"
                android:text="Синхронизировано" />
        </LinearLayout>

        <!-- Инлайн-поле поиска: плашка с лупой + плейсхолдер. -->
        <LinearLayout
            android:id="@+id/searchField"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_field"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_marginLeft="@dimen/space_l"
            android:layout_marginRight="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_s"
            android:paddingLeft="@dimen/space_m"
            android:paddingRight="@dimen/space_m"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="@color/text_secondary"
                android:scaleType="centerInside"
                android:contentDescription="Поиск" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Potok.Body"
                android:textColor="@color/potok_text_disabled"
                android:text="Поиск заметок" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/chipsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:paddingLeft="@dimen/space_m"
                android:paddingRight="@dimen/space_m"
                android:paddingTop="4dp"
                android:paddingBottom="96dp"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🎤 Нажмите микрофон\nили скажите на часах"
                android:textAppearance="@style/TextAppearance.Potok.Title"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="32dp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />

            <!-- «+ Новая заметка» — слева внизу (как на референсе). -->
            <LinearLayout
                android:id="@+id/newNoteBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="bottom|start"
                android:orientation="horizontal"
                android:layout_marginLeft="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_l"
                android:background="@drawable/bg_btn_new_note"
                android:paddingLeft="14dp"
                android:paddingRight="18dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_add"
                    android:tint="@color/accent_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="Добавить" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:textAppearance="@style/TextAppearance.Potok.Title"
                    android:textColor="@color/accent_blue"
                    android:text="Новая заметка" />
            </LinearLayout>

            <!-- Кнопка записи: зелёный круг + белый микрофон, справа внизу (как было). -->
            <ImageButton
                android:id="@+id/recFab"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="20dp"
                android:background="@drawable/bg_fab"
                android:src="@drawable/ic_mic"
                android:scaleType="center"
                android:elevation="4dp"
                android:contentDescription="Запись" />

            <!-- Статус записи: пилюля над FAB. -->
            <LinearLayout
                android:id="@+id/recPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="88dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:elevation="2dp"
                android:visibility="gone">

                <View
                    android:id="@+id/recLevelDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_green" />

                <TextView
                    android:id="@+id/recTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textAppearance="@style/TextAppearance.Potok.Body"
                    android:textColor="@color/text_primary"
                    android:text="0:00" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

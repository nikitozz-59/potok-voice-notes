<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="12dp"
            android:paddingTop="20dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Potok.Headline"
                android:textColor="@color/text_primary"
                android:text="Поток" />

            <ImageButton
                android:id="@+id/searchBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_search"
                android:scaleType="centerInside"
                android:contentDescription="Поиск" />

            <ImageButton
                android:id="@+id/overflowBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_more"
                android:scaleType="centerInside"
                android:contentDescription="Меню" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/syncBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/sync_bg"
            android:padding="@dimen/space_m"
            android:layout_marginLeft="@dimen/space_l"
            android:layout_marginRight="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_s"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/syncIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/cal_text" />

            <TextView
                android:id="@+id/syncText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/sync_blue" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/chipsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:paddingBottom="96dp"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🎤 Нажмите микрофон\nили скажите на часах"
                android:textAppearance="@style/TextAppearance.Potok.Title"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="32dp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

            <ImageButton
                android:id="@+id/recFab"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="20dp"
                android:background="@drawable/bg_fab"
                android:src="@drawable/ic_mic"
                android:scaleType="center"
                android:contentDescription="Запись" />

            <!-- Статус записи: единственный индикатор, видимый только пока идёт
                 запись (индикатор по исключению). Точка-уровень 8dp + таймер. -->
            <LinearLayout
                android:id="@+id/recPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="88dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:elevation="2dp"
                android:visibility="gone">

                <View
                    android:id="@+id/recLevelDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_green" />

                <TextView
                    android:id="@+id/recTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textAppearance="@style/TextAppearance.Potok.Body"
                    android:textColor="@color/text_primary"
                    android:text="0:00" />
            </LinearLayout>
        </FrameLayout>

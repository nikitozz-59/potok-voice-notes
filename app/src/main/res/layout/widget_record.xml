<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widgetBtnRec"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_fab"
        android:src="@drawable/ic_mic"
        android:scaleType="center"
        android:contentDescription="Запись" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="12dp">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Поток"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Potok.Title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Нажмите для быстрой записи"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Potok.Caption"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>

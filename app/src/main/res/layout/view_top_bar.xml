<?xml version="1.0" encoding="utf-8"?>
<!-- Настраиваемая шапка экрана: заголовок слева, до двух иконок-кнопок справа.
     Заменяет системный ActionBar на всех экранах (тема NoActionBar).
     Преимущества: единый стиль Misans под заголовком, тёмная тема через
     android:textColor, больше контроля над отступами. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:scaleType="centerInside"
            android:contentDescription="Назад"
            android:visibility="gone" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:textAppearance="@style/TextAppearance.Potok.Headline"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/actionBtn1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/actionBtn2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:visibility="gone" />
    </LinearLayout>
</merge>

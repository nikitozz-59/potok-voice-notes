<?xml version="1.0" encoding="utf-8"?>
<!-- Экран настроек. Раз-в-жизнь: ключи провайдеров.
     Шапка с back-кнопкой, секции разделены отступами space_xl,
     поля на поверхности potok_surface_secondary с радиусом s. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/space_m"
        android:paddingRight="@dimen/space_l"
        android:paddingTop="@dimen/space_l"
        android:paddingBottom="@dimen/space_m">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_revert"
            android:scaleType="centerInside"
            android:contentDescription="Назад" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Potok.Headline"
            android:textColor="@color/text_primary"
            android:text="Настройки" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/space_l"
            android:paddingRight="@dimen/space_l"
            android:paddingBottom="@dimen/space_xxl">

            <!-- ============ STT ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Распознавание речи (STT)"
                android:textAppearance="@style/TextAppearance.Potok.Title"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Ключ хранится только на телефоне. Nexara — основной, OpenAI-совместимый — запасной."
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="API-ключ Nexara"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/keyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="@string/key_hint"
                android:inputType="textVisiblePassword"
                android:textAppearance="@style/TextAppearance.Potok.Body"
                android:fontFamily="monospace"
                android:background="@drawable/bg_field"
                android:padding="@dimen/space_m" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="Запасной провайдер"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <Spinner
                android:id="@+id/sttProviderSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_field"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="Base URL (для OpenAI-совместимого)"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/sttBaseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="https://api.groq.com/openai/v1"
                android:inputType="textUri"
                android:textAppearance="@style/TextAppearance.Potok.Body"
                android:background="@drawable/bg_field"
                android:padding="@dimen/space_m" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="Модель (для OpenAI-совместимого)"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/sttModelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="whisper-large-v3"
                android:inputType="text"
                android:textAppearance="@style/TextAppearance.Potok.Body"
                android:background="@drawable/bg_field"
                android:padding="@dimen/space_m" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="API-ключ (для OpenAI-совместимого)"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/sttKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:inputType="textVisiblePassword"
                android:textAppearance="@style/TextAppearance.Potok.Body"
                android:fontFamily="monospace"
                android:background="@drawable/bg_field"
                android:padding="@dimen/space_m" />

            <!-- ============ LLM ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="ИИ-извлечение (LLM)"
                android:textAppearance="@style/TextAppearance.Potok.Title"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Типизация заметки и извлечение даты напоминания. OpenAI-совместимый endpoint."
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="Base URL"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/llmBaseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="https://plusvibeapi.ru/v1"
                android:inputType="textUri"
                android:textAppearance="@style/TextAppearance.Potok.Body"
                android:background="@drawable/bg_field"
                android:padding="@dimen/space_m" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="Модель"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/llmModelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="z-ai/glm-5.2"
                android:inputType="text"
                android:textAppearance="@style/TextAppearance.Potok.Body"
                android:background="@drawable/bg_field"
                android:padding="@dimen/space_m" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="API-ключ"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/llmKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:inputType="textVisiblePassword"
                android:textAppearance="@style/TextAppearance.Potok.Body"
                android:fontFamily="monospace"
                android:background="@drawable/bg_field"
                android:padding="@dimen/space_m" />

            <!-- ============ Обработчики ============ -->
            <Button
                android:id="@+id/processorsBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_xl"
                android:text="Обработчики (свои роли)"
                android:background="@drawable/bg_btn_outlined"
                android:textColor="@color/text_primary"
                android:textAllCaps="false" />

            <!-- ============ Сохранить ============ -->
            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/save"
                android:background="@drawable/bg_btn_accent"
                android:textColor="#FFFFFF"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:textAppearance="@style/TextAppearance.Potok.Caption"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Компактная строка заметки (одна строка). Плоская: без карточного фона,
     без цветного облачка. Тип — только emoji. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/space_l"
    android:paddingRight="@dimen/space_l"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Potok.Body"
        android:text="•" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Potok.Body"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Potok.Caption"
        android:textColor="@color/text_secondary" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Компактная карточка заметки (одна строка). Белая, скруглённая.
     Слева — цветная плитка-тип, затем заголовок и время справа. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s"
    android:paddingLeft="@dimen/space_m"
    android:paddingRight="@dimen/space_m"
    android:background="@drawable/bg_card_note"
    android:elevation="1dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_type_note"
        android:background="@drawable/bg_type_tile"
        android:tint="@color/bg_card"
        android:scaleType="centerInside"
        android:padding="4dp"
        android:contentDescription="Тип заметки" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Potok.Body"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Potok.Caption"
        android:textColor="@color/text_secondary" />
</LinearLayout>
